<?xml version="1.0" encoding="utf-8"?>
<!--
  카메라 앱에 넘겨주는 임시 파일 경로만 공개 (Capacitor 기본값은 외부 저장소 전체 "." 였음 → 좁힘).
  Capacitor 는 촬영용 임시 파일을 getExternalFilesDir(Pictures) 에 만든다.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="capture_images" path="Pictures/" />
    <cache-path name="my_cache_images" path="." />
</paths>
