<?xml version="1.0" encoding="utf-8"?>
<!--
  자동 백업 정책 (Android 12+): 클라우드 백업·기기 간 이전 모두 제외.
  눈바디 사진은 "현재 기기에만" 보관하고, 지문 열쇠(Keystore)는 원래 다른 기기로 옮겨지지 않는다.
  로그인 상태·설정도 새 기기에서 다시 로그인하면 서버에서 받아오므로 백업하지 않는다.
  Android 11 이하는 AndroidManifest 의 allowBackup="false" / fullBackupContent="false" 로 같은 정책.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
