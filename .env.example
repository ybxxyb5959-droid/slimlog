# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 git 에 안 올라감)
# 비워두면 목업 모드로 동작한다.

# Supabase 프로젝트 주소와 anon(publishable) 키 — Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 개발 서버에서만 개발용 이메일 로그인 노출 (로컬 Supabase 테스트용). 운영에서는 비워 둔다.
VITE_DEV_LOGIN=

# ⚠ service_role 키는 절대 여기에 넣지 않는다 (브라우저에 노출됨). FastAPI 서버 환경변수에만.
